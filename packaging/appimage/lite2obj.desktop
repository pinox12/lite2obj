[Desktop Entry]
Type=Application
Name=lite2obj
GenericName=Renderizador de Litematica
Comment=Renderiza esquemáticos .litematic y los exporta a OBJ para Blender
Exec=lite2obj %f
Icon=lite2obj
Terminal=false
Categories=Graphics;3DGraphics;
